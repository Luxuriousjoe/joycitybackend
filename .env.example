NODE_ENV=development
PORT=5000

# Use the Internal Database URL on Render. Use the External URL locally.
DATABASE_URL=postgresql://user:password@host:5432/database
# Set true only for an external URL that does not already include sslmode=require.
DATABASE_SSL=false
DB_POOL_MAX=10

# Optional first-deploy admin. Remove these after the first successful deploy.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
MAX_FILE_SIZE_MB=500
