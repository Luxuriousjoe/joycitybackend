NODE_ENV=development
PORT=5000

# Use the Internal Database URL on Render. Use the External URL locally.
DATABASE_URL=postgresql://user:password@host:5432/database
# Set true only for an external URL that does not already include sslmode=require.
DATABASE_SSL=false
DB_POOL_MAX=10

# Optional first-deploy admin. Remove these after the first successful deploy.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
MAX_FILE_SIZE_MB=500

# Primary app storage. OAuth is recommended for a normal My Drive folder.
# Use service_account only when the destination is a Shared Drive.
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Type-specific folders fall back to MEDIA_FOLDER_ID, then FOLDER_ID.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_MEDIA_FOLDER_ID=
GOOGLE_DRIVE_PHOTO_FOLDER_ID=
GOOGLE_DRIVE_VIDEO_FOLDER_ID=
GOOGLE_DRIVE_AUDIO_FOLDER_ID=
GOOGLE_DRIVE_THUMBNAIL_FOLDER_ID=

# Church media is directly viewable by the app when this is true.
GOOGLE_DRIVE_PUBLIC_FILES=true
